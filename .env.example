# Copy to .env and fill in. Everything here can also be set as an environment variable.
# The active settings below are the FREE setup: local embeddings + local reranker + a free LLM.

# docker compose sets this for the app container; this value is for running Python on your host
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# ---------------------------------------------------------------- embeddings
# Free: runs on CPU inside the app container (downloaded once, ~130 MB)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Paid alternative:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# OPENAI_API_KEY=
# Changing the embedding model needs a re-ingest: python -m rag reset && python -m rag ingest

# ---------------------------------------------------------------- reranker
# Free: cross-encoder on CPU. Use "none" to skip reranking.
RERANKER=local

# ---------------------------------------------------------------- LLM (pick ONE block)
# A) Ollama on this server, fully free and private. Start with: docker compose --profile ollama up -d
#    then pull a model once: docker compose exec ollama ollama pull llama3.2:3b
LLM_PROVIDER=openai
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.2:3b

# B) Google Gemini free tier (key from aistudio.google.com, no card needed). Better answers than a 3B model.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=<current free Flash model name from AI Studio>
# LLM_API_KEY=

# C) Groq free tier (key from console.groq.com)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<a model from Groq's model list>
# LLM_API_KEY=

# D) Anthropic (paid)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=

# LLM-as-judge model for the eval (defaults to LLM_MODEL; a stronger one gives a fairer grade)
# JUDGE_MODEL=

# Optional, USD per 1M tokens, to get cost per query in the eval report (0 for free setups)
PRICE_LLM_INPUT=0
PRICE_LLM_OUTPUT=0
PRICE_EMBEDDING=0

# Where the web UI listens. 127.0.0.1 = this machine only. 0.0.0.0 = your LAN / Tailscale.
# The app has no login: never port-forward 8000 on your router.
APP_BIND=127.0.0.1
# Host port for the UI; change it if 8000 is already taken (e.g. by Portainer)
APP_PORT=8000
