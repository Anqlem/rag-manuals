// Eval set for s71200_system_manual_en-US_en-US.pdf (Siemens S7-1200 system manual, 1,028 pages).
// Questions were drafted with an LLM's help (origin: "llm") and every gold page was checked against the extracted text.
// Rule: gold = EVERY page that contains the answer. Page numbers are PDF page numbers (1-based), not printed page numbers.
{"id": "s7_01", "question": "PLC drops into STOP every time I push an SD card in, even with the machine running. Is that normal?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [125]}], "reference_answer": "Yes. Inserting any memory card (program, transfer or firmware card) into a running CPU sends it to STOP immediately; only insert it when the process is in a safe state.", "origin": "llm", "tags": ["symptom", "memory-card", "safety"]}
{"id": "s7_02", "question": "Somebody set a password on the PLC and nobody remembers it. How do I get back in?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [136]}], "reference_answer": "Insert an empty transfer card: it erases the password-protected program from internal load memory, then download a new program. CPU must be in STOP; remove the card before switching to RUN.", "origin": "llm", "tags": ["procedure", "memory-card"]}
{"id": "s7_03", "question": "The red ERROR LED on the CPU is blinking. What can cause that?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [783]}], "reference_answer": "Flashing red means an error such as an internal CPU error, a memory card error or a configuration error (mismatched modules). Solid red means defective hardware.", "origin": "llm", "tags": ["led", "symptom"]}
{"id": "s7_04", "question": "STOP/RUN light keeps alternating green and yellow. What is the CPU doing?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [783]}], "reference_answer": "It is in STARTUP mode (also shown during self-test or firmware update).", "origin": "llm", "tags": ["led"]}
{"id": "s7_05", "question": "What's the default limit for the scan cycle time and how high can I set it?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [98, 262]}], "reference_answer": "Default maximum scan cycle time is 150 ms, configurable from 1 to 6000 ms.", "origin": "llm", "tags": ["spec", "cycle-time"]}
{"id": "s7_06", "question": "My program occasionally runs longer than the cycle time limit. Will the PLC go to STOP?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [97, 89]}], "reference_answer": "By default a time error is logged in the diagnostic buffer and the CPU stays in RUN (or runs OB 80 if present). If the maximum cycle time is exceeded twice without resetting, the CPU goes to STOP. RE_TRIGR can extend the cycle up to 10x the configured maximum.", "origin": "llm", "tags": ["symptom", "cycle-time", "multi-page"]}
{"id": "s7_07", "question": "It gets to about 55 degrees inside our cabinet. Is it OK to mount the CPU vertically?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [833, 50]}], "reference_answer": "No. Vertical mounting is rated only up to 50 °C (horizontal up to 60 °C); vertical mounting reduces the allowed ambient by 10 °C.", "origin": "llm", "tags": ["spec", "installation", "multi-page", "reasoning"]}
{"id": "s7_08", "question": "How much free space do I have to leave around the PLC in the enclosure?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [50]}], "reference_answer": "At least 25 mm above and below the devices, and at least 25 mm of depth between the front of the modules and the enclosure.", "origin": "llm", "tags": ["installation"]}
{"id": "s7_09", "question": "The sensor supply on the CPU isn't enough. Can I put another 24 V power supply in parallel with it?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [51]}], "reference_answer": "No. Never connect an external 24 VDC supply in parallel with the CPU sensor supply; the two supplies fight and can fail. Power different points with each, and connect the commons (M).", "origin": "llm", "tags": ["safety", "wiring"]}
{"id": "s7_10", "question": "How much 24 V current can a 1214C provide for sensors?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [857]}], "reference_answer": "400 mA max sensor power.", "origin": "llm", "tags": ["spec", "model-specific"]}
{"id": "s7_11", "question": "How many I/O expansion modules can I attach to a 1212C?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [847]}], "reference_answer": "2 signal modules max (plus 1 SB/CB/BB and up to 3 communication modules).", "origin": "llm", "tags": ["spec", "model-specific", "confuser"]}
{"id": "s7_12", "question": "Can I add signal modules to the smallest CPU, the 1211C?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [837]}], "reference_answer": "No, the 1211C supports no signal modules; only 1 signal/communication/battery board and up to 3 communication modules.", "origin": "llm", "tags": ["spec", "model-specific", "confuser"]}
{"id": "s7_13", "question": "We shut the line down for three weeks and afterwards the PLC clock was wrong. Why, and how do I stop it happening?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [104, 858, 962]}], "reference_answer": "The clock is backed up by a super-capacitor that lasts typically 20 days (12 days min at 40 °C) after 24 h of power. For longer outages, fit the BB 1297 battery board (about 1 year hold-up, CR1025 battery).", "origin": "llm", "tags": ["symptom", "multi-page", "reasoning"]}
{"id": "s7_14", "question": "Which battery goes in the BB 1297 board, and does it come with one?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [962]}], "reference_answer": "A CR1025 (3 V); it is not included and must be bought separately.", "origin": "llm", "tags": ["parts"]}
{"id": "s7_15", "question": "How do I wipe a 1200 back to factory defaults without losing its IP address?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [789, 790]}], "reference_answer": "With no memory card inserted, online and in STOP: Online & Diagnostics > Functions > Reset to factory settings, tick 'Keep IP address', click Reset and confirm. Memory, parameters, diagnostic buffer and time of day are cleared.", "origin": "llm", "tags": ["procedure", "multi-page"]}
{"id": "s7_16", "question": "How do I switch on the PLC's web interface and force HTTPS?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [603]}], "reference_answer": "In Device Configuration select the CPU, open 'Web server' in the properties, tick 'Activate web server on this module' and 'Permit access only with HTTPS', then download.", "origin": "llm", "tags": ["procedure", "security"]}
{"id": "s7_17", "question": "A DC output on the CPU died after a wiring short. Don't the outputs have short-circuit protection?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [835]}], "reference_answer": "No. DC outputs on CPUs, signal modules and signal boards have no short-circuit protection.", "origin": "llm", "tags": ["symptom", "spec"]}
{"id": "s7_18", "question": "What supply voltage range does a 24 V DC CPU tolerate?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [834, 839, 840, 841, 849, 850, 851, 859, 860, 861, 870, 871, 882, 883]}], "reference_answer": "20.4 to 28.8 VDC.", "origin": "llm", "tags": ["spec"]}
{"id": "s7_19", "question": "Can the PLC go in a dusty area without an extra enclosure?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [49, 834]}], "reference_answer": "No. It is IP20; external protection is required against dust, dirt, water and objects under 12.5 mm. It must be installed in a housing or cabinet.", "origin": "llm", "tags": ["spec", "installation"]}
{"id": "s7_20", "question": "Is it fine to call PID_Compact from OB1?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [418]}], "reference_answer": "No. Run the PID instruction at constant sampling intervals, preferably in a cyclic interrupt OB, not in the main program cycle OB such as OB 1.", "origin": "llm", "tags": ["programming"]}
{"id": "s7_21", "question": "I need pulse outputs for a stepper on a 1214C AC/DC/Relay. What do I have to add?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [858]}], "reference_answer": "A digital signal board (SB); CPUs with relay outputs need an SB to use pulse outputs.", "origin": "llm", "tags": ["model-specific", "reasoning"]}
{"id": "s7_22", "question": "I have five devices on an RS485 bus. Which of them need termination switched on?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [670]}], "reference_answer": "Only the two end devices are terminated and biased; devices in between have termination and bias off.", "origin": "llm", "tags": ["wiring", "communication"]}
{"id": "s7_23", "question": "What's the most holding registers I can read in one Modbus request?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [727]}], "reference_answer": "125 words per request.", "origin": "llm", "tags": ["communication", "table"]}
{"id": "s7_24", "question": "An extended instruction gives back error 8x3A. What's wrong?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [407]}], "reference_answer": "The DB does not exist; x is the number of the parameter with the error.", "origin": "llm", "tags": ["error-code", "table"]}
{"id": "s7_25", "question": "Which protection level still lets the HMI read data but needs a password to write or change RUN/STOP?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [190]}], "reference_answer": "Read access: HMI and PLC-to-PLC communication work without a password; writing to the CPU and changing mode require it.", "origin": "llm", "tags": ["security"]}
{"id": "s7_26", "question": "Can I use my old V3.0 transfer card in a new V4.0 CPU?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [125]}], "reference_answer": "No. V3.0 transfer cards are incompatible and cause a CPU error. Remove it, do STOP-to-RUN, MRES or a power cycle, and convert the project with Change Device in TIA Portal.", "origin": "llm", "tags": ["memory-card", "compatibility"]}
{"id": "s7_27", "question": "When I pull the program card out, the PLC stops and the error light flashes. Why?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [124]}], "reference_answer": "A program card is external load memory; inserting it erased internal load memory, so the card must stay in the CPU. Removing it sends the CPU to STOP.", "origin": "llm", "tags": ["symptom", "memory-card"]}
{"id": "s7_28", "question": "How long does the CPU need to be powered before the clock backup is fully charged?", "answerable": true, "gold": [{"doc": "s71200_system_manual_en-US_en-US.pdf", "pages": [104]}], "reference_answer": "At least 24 hours.", "origin": "llm", "tags": ["spec"]}
{"id": "s7_u01", "question": "Does the S7-1200 support OPC UA?", "answerable": false, "reference_answer": "Not covered in this manual edition (newer firmware adds it, which makes this a good hallucination trap).", "origin": "llm", "tags": ["unanswerable", "trap"]}
